<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Все сетевые запросы идут из нативного кода по HTTPS. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
